[resource]
code = "shader_type canvas_item;
render_mode blend_mix;




void vertex() {
// Input:2
	mat4 n_out2p0 = CANVAS_MATRIX;


// Input:5
	mat4 n_out5p0 = MODEL_MATRIX;


// Input:3
	vec2 n_out3p0 = VERTEX;


// TransformVectorMult:6
	vec3 n_out6p0 = (n_out5p0 * vec4(vec3(n_out3p0, 0.0), 1.0)).xyz;


// TransformVectorMult:4
	vec3 n_out4p0 = (n_out2p0 * vec4(n_out6p0, 1.0)).xyz;


// VectorOp:8
	vec2 n_in8p1 = vec2(640.00000, 1000.00000);
	vec2 n_out8p0 = vec2(n_out4p0.xy) / n_in8p1;
	float n_out8p1 = n_out8p0.r;
	float n_out8p2 = n_out8p0.g;


// VectorCompose:7
	vec2 n_out7p0 = vec2(n_out8p1, n_out8p2);
	float n_out7p1 = n_out7p0.r;
	float n_out7p2 = n_out7p0.g;


// FloatOp:30
	float n_in30p1 = 1.00000;
	float n_out30p0 = n_out7p1 / n_in30p1;


// FloatOp:27
	float n_in27p1 = 5.00000;
	float n_out27p0 = n_out30p0 * n_in27p1;


// FloatFunc:28
	float n_out28p0 = floor(n_out27p0);


// FloatOp:29
	float n_in29p1 = 5.00000;
	float n_out29p0 = n_out28p0 / n_in29p1;


// FloatOp:41
	float n_in41p1 = 1.00000;
	float n_out41p0 = n_out7p2 / n_in41p1;


// FloatOp:38
	float n_in38p1 = 8.00000;
	float n_out38p0 = n_out41p0 * n_in38p1;


// FloatFunc:39
	float n_out39p0 = floor(n_out38p0);


// FloatOp:40
	float n_in40p1 = 8.00000;
	float n_out40p0 = n_out39p0 / n_in40p1;


// VectorCompose:36
	float n_in36p2 = 0.00000;
	vec3 n_out36p0 = vec3(n_out29p0, n_out40p0, n_in36p2);


// Output:0
	COLOR.rgb = n_out36p0;


}
